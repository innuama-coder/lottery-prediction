{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:autoresearch-lotte:phase0:soak-log-entry:1.0.0","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","request_id","game","planned_at_utc","started_at_utc","completed_at_utc","clock_check_at_utc","clock_offset_seconds","attempts","result","failure_injection","evidence_ref"],
