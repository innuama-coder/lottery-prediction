{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","identity","status","terminal","process_exit_code","completed_replications","checkpoint_sha256","ledger_sha256","command","pid"],
