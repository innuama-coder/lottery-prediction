{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "status", "baseline_validation", "cases", "input_identity"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "artifact_type": {"const": "phase2_1_final_validator_negative_suite"},
    "release_id": {"const": "P2.1-R00-60d02be4dbe9-i05"},
    "status": {"const": "PASS"},
    "baseline_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["input_bundle", "command", "exit_code", "duration_seconds", "terminal", "frozen_power_evidence", "production_verification_receipt"],
      "properties": {
        "input_bundle": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"const": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "terminal": {"const": "PASS"},
        "frozen_power_evidence": {"type": "object"},
        "production_verification_receipt": {"type": "object"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "input_bundle", "command", "exit_code", "duration_seconds", "terminal", "production_verification_receipt"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "input_bundle": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "number", "minimum": 0},
          "terminal": {"enum": ["EVIDENCE_MISMATCH", "INVALID_CONTRACT", "ENVIRONMENT_FAILURE"]},
          "production_verification_receipt": {"type": "object"}
        }
      }
    },
    "input_identity": {"type": "object", "required": ["release_id", "baseline_sha", "phase1_frozen", "phase2_frozen", "task_inputs", "task_input_aggregate_sha256"]}
  }
}
