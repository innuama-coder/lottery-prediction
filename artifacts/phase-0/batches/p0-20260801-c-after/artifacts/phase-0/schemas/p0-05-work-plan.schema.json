{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:autoresearch-lotte:phase0:p0-05-work-plan:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "generated_at_utc", "status", "selection_algorithm_version", "changed_field_order", "budget_audit", "games", "network_runner_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "p0_05_work_plan"}, "contract_version": {"const": "1.3"},
    "generated_at_utc": {"type": "string", "format": "date-time"}, "status": {"const": "completed_hold_budget_reconciliation_required"},
    "selection_algorithm_version": {"const": "p0-05-mechanical-union-v1"},
    "changed_field_order": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["bundle_id", "number_space_version", "draw_process_version", "prize_rule_version", "active_promotion_ids"]}},
    "budget_audit": {"$ref": "#/$defs/budget"}, "games": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/game"}},
    "network_runner_authorized": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{7}$"}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["total_request_budget", "p0_06_reserved_requests", "p0_04_actual_requests", "p0_02_direct_request_lower_bound", "p0_02_direct_request_exact", "remaining_formula", "dlt_required_new_requests", "dlt_feasible_only_if_p0_02_requests_lte", "certified_authorized_new_requests"], "properties": {"total_request_budget": {"const": 96}, "p0_06_reserved_requests": {"const": 24}, "p0_04_actual_requests": {"const": 1}, "p0_02_direct_request_lower_bound": {"const": 8}, "p0_02_direct_request_exact": {"type": "null"}, "remaining_formula": {"const": "71-N_p0_02_direct_requests"}, "dlt_required_new_requests": {"const": 51}, "dlt_feasible_only_if_p0_02_requests_lte": {"const": 20}, "certified_authorized_new_requests": {"const": 0}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["previous_issue_id", "issue_id", "previous_bundle_id", "bundle_id", "changed_fields"], "properties": {"previous_issue_id": {"type": "string", "pattern": "^[0-9]{7}$"}, "issue_id": {"type": "string", "pattern": "^[0-9]{7}$"}, "previous_bundle_id": {"type": "string", "minLength": 1}, "bundle_id": {"type": "string", "minLength": 1}, "changed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "work_record": {"type": "object", "additionalProperties": false, "required": ["issue_id", "bundle_id", "inclusion_reasons"], "properties": {"issue_id": {"type": "string", "pattern": "^[0-9]{7}$"}, "bundle_id": {"type": "string", "minLength": 1}, "inclusion_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["frozen_sample", "transition_previous", "transition_at", "transition_next"]}}}},
    "external_audit": {"type": "object", "additionalProperties": false, "required": ["supplied_transition_sha256", "supplied_work_records_sha256", "comparison_status"], "properties": {"supplied_transition_sha256": {"$ref": "#/$defs/hash"}, "supplied_work_records_sha256": {"$ref": "#/$defs/hash"}, "comparison_status": {"const": "not_comparable_canonical_shape_not_recorded"}}},
    "game": {"type": "object", "additionalProperties": false, "required": ["game", "sample_issue_ids", "sample_issue_ids_sha256", "parent_expected_sample_sha256", "transition_records", "transition_issue_ids", "transition_records_sha256", "work_issue_ids", "work_issue_ids_sha256", "parent_expected_work_issue_ids_sha256", "work_records", "work_records_sha256", "external_audit_hashes", "counts", "existing_reusable_evidence_issue_ids", "planned_new_issue_ids", "certified_authorized_new_requests"], "properties": {"game": {"enum": ["dlt", "ssq"]}, "sample_issue_ids": {"$ref": "#/$defs/issues"}, "sample_issue_ids_sha256": {"$ref": "#/$defs/hash"}, "parent_expected_sample_sha256": {"$ref": "#/$defs/hash"}, "transition_records": {"type": "array", "items": {"$ref": "#/$defs/transition"}}, "transition_issue_ids": {"$ref": "#/$defs/issues"}, "transition_records_sha256": {"$ref": "#/$defs/hash"}, "work_issue_ids": {"$ref": "#/$defs/issues"}, "work_issue_ids_sha256": {"$ref": "#/$defs/hash"}, "parent_expected_work_issue_ids_sha256": {"$ref": "#/$defs/hash"}, "work_records": {"type": "array", "items": {"$ref": "#/$defs/work_record"}}, "work_records_sha256": {"$ref": "#/$defs/hash"}, "external_audit_hashes": {"$ref": "#/$defs/external_audit"}, "counts": {"type": "object", "additionalProperties": false, "required": ["sample", "transition", "work_union"], "properties": {"sample": {"type": "integer"}, "transition": {"type": "integer"}, "work_union": {"type": "integer"}}}, "existing_reusable_evidence_issue_ids": {"$ref": "#/$defs/issues"}, "planned_new_issue_ids": {"$ref": "#/$defs/issues"}, "certified_authorized_new_requests": {"const": 0}}}
  }
}
