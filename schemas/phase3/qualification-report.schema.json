{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","identity","status","terminal","non_formal_synthetic_only","formal_run_authorized","completed_replications","required_replications","uniform_false_selection_count","uniform_false_selection_rate","uniform_false_selection_rate_max","uniform_false_selection_event","injected_direction_recovered_count","injected_direction_recovery_rate","injected_direction_recovery_rate_min","negative_control_count","negative_control_coverage","expected_terminal_match_rate","blocking_findings","generator_source_sha256","replication_evidence_sha256","replication_index_unique","deterministic_reconstruction","checkpoint_recovery","failure_injection","probability_audits","bottom_up_validation"],
  "properties":{
    "schema_version":{"const":"3.0.0"},"artifact_type":{"const":"phase3_qualification_report"},"identity":{"type":"string","minLength":1},"status":{"enum":["PASS","HOLD"]},"terminal":{"enum":["PASS","HOLD_QUALIFICATION_THRESHOLD"]},"non_formal_synthetic_only":{"const":true},"formal_run_authorized":{"const":false},
    "completed_replications":{"$ref":"#/$defs/replicationCounts"},"required_replications":{"const":{"uniform":1000,"injected":1000}},
    "uniform_false_selection_count":{"type":"integer","minimum":0,"maximum":1000},"uniform_false_selection_rate":{"type":"number","minimum":0,"maximum":1},"uniform_false_selection_rate_max":{"const":0.05},"uniform_false_selection_event":{"type":"string","minLength":1},
    "injected_direction_recovered_count":{"type":"integer","minimum":0,"maximum":1000},"injected_direction_recovery_rate":{"type":"number","minimum":0,"maximum":1},"injected_direction_recovery_rate_min":{"const":0.9},
    "negative_control_count":{"type":"integer","minimum":1},"negative_control_coverage":{"type":"number","minimum":0,"maximum":1},"expected_terminal_match_rate":{"type":"number","minimum":0,"maximum":1},"blocking_findings":{"type":"integer","minimum":0},
    "generator_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"replication_evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"replication_index_unique":{"type":"boolean"},
    "deterministic_reconstruction":{
      "type":"object","additionalProperties":false,"required":["sampled_count","sampled_expected","matched_count","sampled_match_rate"],
      "properties":{"sampled_count":{"type":"integer","minimum":0},"sampled_expected":{"const":6},"matched_count":{"type":"integer","minimum":0},"sampled_match_rate":{"type":"number","minimum":0,"maximum":1}}
    },
    "checkpoint_recovery":{
      "type":"object","additionalProperties":false,"required":["cross_process","stage_pid","resume_pid","stage_command","resume_command","stage_receipt_sha256","checkpoint_sha256","ledger_before_resume_sha256","same_identity_same_payload","wrong_identity","tampered_payload"],
      "properties":{"cross_process":{"type":"boolean"},"stage_pid":{"type":"integer","minimum":1},"resume_pid":{"type":"integer","minimum":1},"stage_command":{"type":"array","minItems":1,"items":{"type":"string"}},"resume_command":{"type":"array","minItems":1,"items":{"type":"string"}},"stage_receipt_sha256":{"$ref":"#/$defs/sha"},"checkpoint_sha256":{"$ref":"#/$defs/sha"},"ledger_before_resume_sha256":{"$ref":"#/$defs/sha"},"same_identity_same_payload":{"const":"PASS"},"wrong_identity":{"const":"REJECTED"},"tampered_payload":{"const":"REJECTED"}}
    },
    "failure_injection":{
      "type":"object","additionalProperties":false,"required":["timeout","crash","retry","ledger_sha256","status"],
      "properties":{
        "timeout":{"type":"object","additionalProperties":false,"required":["injected","observed","timeout_seconds"],"properties":{"injected":{"const":true},"observed":{"type":"boolean"},"timeout_seconds":{"type":"number","exclusiveMinimum":0}}},
        "crash":{"type":"object","additionalProperties":false,"required":["injected","observed_returncode","expected_returncode"],"properties":{"injected":{"const":true},"observed_returncode":{"type":"integer"},"expected_returncode":{"const":17}}},
        "retry":{"type":"object","additionalProperties":false,"required":["attempt_count","failed_attempt_retained","parent_attempt_id","canonical_attempt_id","retry_returncode"],"properties":{"attempt_count":{"const":2},"failed_attempt_retained":{"type":"boolean"},"parent_attempt_id":{"type":"string"},"canonical_attempt_id":{"type":"string"},"retry_returncode":{"type":"integer"}}},
        "ledger_sha256":{"$ref":"#/$defs/sha"},"status":{"enum":["PASS","FAIL"]}
      }
    },
    "probability_audits":{
      "type":"object","additionalProperties":false,"required":["small_world_combination_count","uniform_probability","uniform_normalization","m1_zero_parameter_max_difference","real_number_spaces","numeric_absolute_tolerance","numeric_relative_tolerance"],
      "properties":{"small_world_combination_count":{"const":120},"uniform_probability":{"type":"number","exclusiveMinimum":0,"maximum":1},"uniform_normalization":{"type":"number"},"m1_zero_parameter_max_difference":{"type":"number","minimum":0},"real_number_spaces":{"$ref":"#/$defs/realSpaces"},"numeric_absolute_tolerance":{"const":1e-12},"numeric_relative_tolerance":{"const":1e-10}}
    },
    "bottom_up_validation":{
      "type":"object","additionalProperties":false,"required":["replication_row_count","key_coverage_match","succeeded_uniform","succeeded_injected","illegal_draw_count","draw_hash_mismatch_count","deterministic_draw_mismatch_count","selected_lambda_mismatch_count","fitted_probability_mismatch_count","outer_skill_mismatch_count","final_theta_mismatch_count","summary_mismatch_count","uniform_false_selection_count","injected_direction_recovered_count","row_schema_coverage","ledger_terminal_coverage","full_replication_recomputation_coverage"],
      "properties":{"replication_row_count":{"type":"integer","minimum":0,"maximum":2000},"key_coverage_match":{"type":"boolean"},"succeeded_uniform":{"type":"integer","minimum":0,"maximum":1000},"succeeded_injected":{"type":"integer","minimum":0,"maximum":1000},"illegal_draw_count":{"type":"integer","minimum":0},"draw_hash_mismatch_count":{"type":"integer","minimum":0},"deterministic_draw_mismatch_count":{"type":"integer","minimum":0},"selected_lambda_mismatch_count":{"type":"integer","minimum":0},"fitted_probability_mismatch_count":{"type":"integer","minimum":0},"outer_skill_mismatch_count":{"type":"integer","minimum":0},"final_theta_mismatch_count":{"type":"integer","minimum":0},"summary_mismatch_count":{"type":"integer","minimum":0},"uniform_false_selection_count":{"type":"integer","minimum":0,"maximum":1000},"injected_direction_recovered_count":{"type":"integer","minimum":0,"maximum":1000},"row_schema_coverage":{"type":"number","minimum":0,"maximum":1},"ledger_terminal_coverage":{"type":"number","minimum":0,"maximum":1},"full_replication_recomputation_coverage":{"type":"number","minimum":0,"maximum":1}}
    }
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "replicationCounts":{"type":"object","additionalProperties":false,"required":["uniform","injected"],"properties":{"uniform":{"type":"integer","minimum":0,"maximum":1000},"injected":{"type":"integer","minimum":0,"maximum":1000}}},
    "realSpaceCase":{"type":"object","additionalProperties":false,"required":["joint_combination_count","legal_probability_positive","illegal_probability_zero","ordering_invariant","partition_joint_product_match","partition_dp_normalization","inclusion_marginal_cardinality_match","status"],"properties":{"joint_combination_count":{"type":"integer","minimum":1},"legal_probability_positive":{"type":"boolean"},"illegal_probability_zero":{"type":"boolean"},"ordering_invariant":{"type":"boolean"},"partition_joint_product_match":{"type":"boolean"},"partition_dp_normalization":{"type":"boolean"},"inclusion_marginal_cardinality_match":{"type":"boolean"},"status":{"enum":["PASS","FAIL"]}}},
    "realSpaces":{"type":"object","additionalProperties":false,"required":["games","game_coverage","status"],"properties":{"games":{"type":"object","additionalProperties":false,"required":["ssq","dlt"],"properties":{"ssq":{"$ref":"#/$defs/realSpaceCase"},"dlt":{"$ref":"#/$defs/realSpaceCase"}}},"game_coverage":{"type":"number","minimum":0,"maximum":1},"status":{"enum":["PASS","FAIL"]}}}
  }
}
