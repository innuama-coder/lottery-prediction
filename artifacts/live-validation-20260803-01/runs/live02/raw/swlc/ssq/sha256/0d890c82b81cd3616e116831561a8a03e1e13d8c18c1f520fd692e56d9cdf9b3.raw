  var lotteryNames = {"tb":"双色球","kl8":"快乐8","3d":"3D","6p1":"六加一","h7":"七乐彩","15c5":"15选5","4d":"天天彩选4"};
  var annMap = {"tb":"https://www.cwl.gov.cn/ygkj/wqkjgg/ssq/","kl8":"https://www.cwl.gov.cn/ygkj/wqkjgg/kl8/","3d":"/shsflcpfxzx/lottery/3d.html","6p1":"/shsflcpfxzx/lottery/df6j1.html","h7":"https://www.cwl.gov.cn/ygkj/wqkjgg/qlc/","15c5":"/shsflcpfxzx/lottery/15c5.html","4d":"/shsflcpfxzx/lottery/ttcx4.html"};
  var previousMap = {"tb":"/shsflcpfxzx/lottery/ssq.html?view=previous","kl8":"/shsflcpfxzx/lottery/kl8.html?view=previous","3d":"/shsflcpfxzx/lottery/3d.html?view=previous","6p1":"/shsflcpfxzx/lottery/df6j1.html?view=previous","h7":"/shsflcpfxzx/lottery/qlc.html?view=previous","15c5":"/shsflcpfxzx/lottery/15c5.html?view=previous","4d":"/shsflcpfxzx/lottery/ttcx4.html?view=previous"};
  var awardMap = {"tb":"/shsflcpfxzx/ssqxb/ssqxb.html","h7":"/shsflcpfxzx/qlcxb/qlcxb.html","kl8":"/shsflcpfxzx/kl8xb/kl8xb.html"};
  var checkMap = {"tb":"/shsflcpfxzx/lottery/ssq.html?view=check","3d":"/shsflcpfxzx/lottery/3d.html?view=check","6p1":"/shsflcpfxzx/lottery/df6j1.html?view=check","h7":"/shsflcpfxzx/lottery/qlc.html?view=check","15c5":"/shsflcpfxzx/lottery/15c5.html?view=check","4d":"/shsflcpfxzx/lottery/ttcx4.html?view=check"};
  var checkExternalMap = {};

  function selectedType() {
    var tabs = document.getElementById('tabs');
    return tabs && tabs.value ? tabs.value : 'tb';
  }

  function go(map, fallbackMap) {
    var type = selectedType();
    var target = map[type] || (fallbackMap && fallbackMap[type]);
    if (target) window.location.href = target;
  }

  window.JumpTab = function () { go(previousMap); };
  window.JumpPre = function () { go(previousMap); };
  window.jumpKJGG = function () { go(annMap); };
  window.jumpDJ = function () { go(awardMap); };
  window.jumpCheck = function () { go(checkMap, checkExternalMap); };

  function ensureLotteryOptions() {
    var tabs = document.getElementById('tabs');
    if (!tabs) return;
    var current = tabs.value || 'tb';
    var existing = {};
    Array.prototype.forEach.call(tabs.options, function (option) { existing[option.value] = true; });
    Object.keys(lotteryNames).forEach(function (type) {
      if (existing[type]) return;
      var option = document.createElement('option');
      option.value = type;
      option.text = lotteryNames[type];
      tabs.appendChild(option);
    });
    if (lotteryNames[current]) tabs.value = current;
  }

  function wireCustomQuery(toggleId, panelId) {
    var toggle = document.getElementById(toggleId);
    var panel = document.getElementById(panelId);
    if (!toggle || !panel) return;
    toggle.addEventListener('click', function (event) {
      event.stopPropagation();
      panel.classList.toggle('is-open');
    });
    panel.addEventListener('click', function (event) { event.stopPropagation(); });
    document.addEventListener('click', function () { panel.classList.remove('is-open'); });
  }

  wireCustomQuery('ssqCustomToggle', 'ssqCustomPanel');
  wireCustomQuery('qlcCustomToggle', 'qlcCustomPanel');
  wireCustomQuery('kl8CustomToggle', 'kl8CustomPanel');
  wireCustomQuery('df6j1CustomToggle', 'df6j1CustomPanel');
  wireCustomQuery('c15c5CustomToggle', 'c15c5CustomPanel');
  wireCustomQuery('ttcx4CustomToggle', 'ttcx4CustomPanel');
  wireCustomQuery('threeDCustomToggle', 'threeDCustomPanel');
  function wireSectionLinks() {
    var links = document.querySelectorAll('.Selectcolor1 a, .Selectcolor2 a, .Selectcolor3 a');
    console.log(links);
    Array.prototype.forEach.call(links, function (link) {
      var text = (link.textContent || '').replace(/\s+/g, '');
      var href = link.getAttribute('href') || '';
      if (href.indexOf('/ssqxb/') >= 0 || href.indexOf('ssqxb.html') >= 0) {
        link.href = awardMap[selectedType()] || link.href;
        console.log(link.href);
        link.onclick = function () { window.jumpDJ(); return false; };
        return;
      }
      if (text.indexOf('开奖公告') >= 0) {
        link.href = annMap[selectedType()] || link.href;
        link.onclick = function () { window.jumpKJGG(); return false; };
      } else if (text.indexOf('往期开奖') >= 0) {
        link.href = previousMap[selectedType()] || link.href;
        link.onclick = function () { window.JumpPre(); return false; };
      } else if (text.indexOf('中奖查询') >= 0) {
        link.href = checkMap[selectedType()] || checkExternalMap[selectedType()] || link.href;
        link.onclick = function () { window.jumpCheck(); return false; };
      }
    });
  }

  ensureLotteryOptions();
  wireSectionLinks();
  var tabs = document.getElementById('tabs');
  if (tabs) tabs.addEventListener('change', wireSectionLinks);
})();
</script><script>(function () {
  var form = document.getElementById('ssqCheckForm');
  if (!form) return;
  var red = new Set();
  var blue = new Set();
  var redButtons = form.querySelectorAll('.ssq-ball.red');
  var blueButtons = form.querySelectorAll('.ssq-ball.blue');
  var redText = document.getElementById('ssqRedText');
  var blueText = document.getElementById('ssqBlueText');
  var hidden = document.getElementById('ssqHiddenInputs');

  function pad(number) {
    return number < 10 ? '0' + number : String(number);
  }

  function sorted(set) {
    return Array.from(set).sort(function (a, b) { return a - b; });
  }

  function render() {
    var redValues = sorted(red);
    var blueValues = sorted(blue);
    redText.value = redValues.map(pad).join(',');
    blueText.value = blueValues.map(pad).join(',');
    hidden.innerHTML = '';
    redValues.forEach(function (value) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'red_numbers[]';
      input.value = value;
      hidden.appendChild(input);
    });
    blueValues.forEach(function (value) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'blue_numbers[]';
      input.value = value;
      hidden.appendChild(input);
    });
  }

  function bind(buttons, set, max) {
    Array.prototype.forEach.call(buttons, function (button) {
      var value = parseInt(button.getAttribute('data-value'), 10);
      if (button.classList.contains('selected')) set.add(value);
      button.addEventListener('click', function () {
        if (set.has(value)) {
          set.delete(value);
          button.classList.remove('selected');
        } else {
          if (set.size >= max) return;
          set.add(value);
          button.classList.add('selected');
        }
        render();
      });
    });
  }

  bind(redButtons, red, 12);
  bind(blueButtons, blue, 16);
  document.getElementById('ssqClear').addEventListener('click', function () {
    red.clear();
    blue.clear();
    Array.prototype.forEach.call(form.querySelectorAll('.ssq-ball.selected'), function (button) {
      button.classList.remove('selected');
    });
    render();
  });
  form.addEventListener('submit', function (event) {
    if (red.size < 6 || red.size > 12 || blue.size < 1 || blue.size > 16) {
      event.preventDefault();
      alert('红色球最少选择6个，最多选择12个。蓝色球最少选择1个，最多选择16个。');
    }
  });
  render();
})();
</script><script>(function () {
  var form = document.getElementById('qlcCheckForm');
  if (!form) return;
  var selected = new Set();
  var numberInput = document.getElementById('qlcNumber');
  var textInput = document.getElementById('qlcSelectedNumber');
  var buttons = form.querySelectorAll('.qlc-number-ball');

  function sorted() {
    return Array.from(selected).sort(function (a, b) { return parseInt(a, 10) - parseInt(b, 10); });
  }

  function normalize(value) {
    value = String(value || '').replace(/\D/g, '');
    if (value === '') return '';
    return value.length === 1 ? '0' + value : value;
  }

  function render() {
    var value = sorted().join(',');
    numberInput.value = value;
    textInput.value = value;
  }

  function qlcSelectBall(button) {
    var value = button.getAttribute('data-value');
    if (selected.has(value)) {
      selected.delete(value);
      button.classList.remove('selected');
    } else {
      if (selected.size >= 12) {
        alert('最多选择12个球。');
        return;
      }
      selected.add(value);
      button.classList.add('selected');
    }
    render();
  }

  function qlcClearSelects() {
    selected.clear();
    Array.prototype.forEach.call(buttons, function (button) { button.classList.remove('selected'); });
    render();
  }

  function qlcCheckNumber(event) {
    render();
    var issueSelect = document.getElementById('Numberofperiods');
    var issue = issueSelect && issueSelect.options[issueSelect.selectedIndex] ? issueSelect.options[issueSelect.selectedIndex].value : '';
    if (selected.size < 7 || selected.size > 12) {
      event.preventDefault();
      alert('最少选择7个球，最多选择12个球。');
      return false;
    }
    if (issue === '') {
      event.preventDefault();
      alert('“对奖期数”必须选择。');
      return false;
    }
    return true;
  }

  (numberInput.value || '').split(',').forEach(function (value) {
    value = normalize(value);
    if (value !== '') selected.add(value);
  });

  Array.prototype.forEach.call(buttons, function (button) {
    if (selected.has(button.getAttribute('data-value'))) button.classList.add('selected');
    button.addEventListener('click', function () { qlcSelectBall(button); });
  });

  document.getElementById('qlcClear').addEventListener('click', qlcClearSelects);
  form.addEventListener('submit', qlcCheckNumber);
  render();
})();
</script><script>(function () {
  var form = document.getElementById('c15c5CheckForm');
  if (!form) return;
  var selected = new Set();
  var numberInput = document.getElementById('c15c5Number');
  var textInput = document.getElementById('txtNumber2');
  var buttons = form.querySelectorAll('.c15c5-number-ball');

  function sorted() {
    return Array.from(selected).sort(function (a, b) { return parseInt(a, 10) - parseInt(b, 10); });
  }

  function render() {
    var value = sorted().join(',');
    numberInput.value = value;
    textInput.value = value;
  }

  (numberInput.value || '').split(',').forEach(function (value) {
    value = value.replace(/\D/g, '');
    if (value === '') return;
    selected.add(value.length === 1 ? '0' + value : value);
  });

  Array.prototype.forEach.call(buttons, function (button) {
    var value = button.getAttribute('data-value');
    if (selected.has(value)) button.classList.add('selected');
    button.addEventListener('click', function () {
      if (selected.has(value)) {
        selected.delete(value);
        button.classList.remove('selected');
      } else {
        if (selected.size >= 5) return;
        selected.add(value);
        button.classList.add('selected');
      }
      render();
    });
  });

  document.getElementById('c15c5Clear').addEventListener('click', function () {
    selected.clear();
    Array.prototype.forEach.call(buttons, function (button) { button.classList.remove('selected'); });
    render();
  });

  form.addEventListener('submit', function (event) {
    render();
    if (selected.size !== 5) {
      event.preventDefault();
      alert('请选择5个号码。');
    }
  });
  render();
})();
</script><script>(function () {
  var form = document.getElementById('df6j1CheckForm');
  if (!form) return;
  var selectedNumbers = ['', '', '', '', '', ''];
  var selectedAnimal = '';
  var numberInput = document.getElementById('df6j1Number');
  var animalInput = document.getElementById('df6j1Animal');
  var textArea = document.getElementById('txtNumber1');
  var numberButtons = form.querySelectorAll('.df6j1-number-ball');
  var animalButtons = form.querySelectorAll('.df6j1-animal-ball');

  function render() {
    var number = selectedNumbers.join('');
    numberInput.value = number;
    animalInput.value = selectedAnimal;
    textArea.value = number || selectedAnimal ? (number + (selectedAnimal ? '+' + selectedAnimal : '')) : '';
  }

  function markInitialState() {
    var initialNumber = (numberInput.value || '').replace(/\D/g, '').slice(0, 6);
    for (var i = 0; i < initialNumber.length; i++) {
      selectedNumbers[i] = initialNumber.charAt(i);
    }
    selectedAnimal = animalInput.value || '';
    Array.prototype.forEach.call(numberButtons, function (button) {
      var pos = parseInt(button.getAttribute('data-pos'), 10) - 1;
      if (selectedNumbers[pos] === button.getAttribute('data-value')) {
        button.classList.add('selected');
      }
    });
    Array.prototype.forEach.call(animalButtons, function (button) {
      if (selectedAnimal === button.getAttribute('data-value')) {
        button.classList.add('selected');
      }
    });
    render();
  }

  Array.prototype.forEach.call(numberButtons, function (button) {
    button.addEventListener('click', function () {
      var pos = parseInt(button.getAttribute('data-pos'), 10) - 1;
      Array.prototype.forEach.call(form.querySelectorAll('.df6j1-number-ball[data-pos="' + (pos + 1) + '"]'), function (peer) {
        peer.classList.remove('selected');
      });
      selectedNumbers[pos] = button.getAttribute('data-value');
      button.classList.add('selected');
      render();
    });
  });

  Array.prototype.forEach.call(animalButtons, function (button) {
    button.addEventListener('click', function () {
      Array.prototype.forEach.call(animalButtons, function (peer) {
        peer.classList.remove('selected');
      });
      selectedAnimal = button.getAttribute('data-value');
      button.classList.add('selected');
      render();
    });
  });

  document.getElementById('df6j1Clear').addEventListener('click', function () {
    selectedNumbers = ['', '', '', '', '', ''];
    selectedAnimal = '';
    Array.prototype.forEach.call(form.querySelectorAll('.df6j1-number-ball.selected,.df6j1-animal-ball.selected'), function (button) {
      button.classList.remove('selected');
    });
    render();
  });

  form.addEventListener('submit', function (event) {
    render();
    if (!/^\d{6}$/.test(numberInput.value) || animalInput.value === '') {
      event.preventDefault();
      alert('请选择完整的6位号码和生肖码。');
    }
  });

  markInitialState();
})();
</script><script>(function () {
