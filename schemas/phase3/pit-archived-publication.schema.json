{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 3 point-in-time archived publication original",
  "description": "Independently archived publication that simultaneously binds game, issue and numbers to a frozen Phase 1 draw and records the historical availability time of the prior draw result. The availability_basis must be an allowed basis; draw dates, HTTP Date headers, retrieval time, first_seen_at, the current page, the current CMS PublishDate and scheduled broadcasts are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "game", "issue_id", "front_numbers", "back_numbers", "availability_basis", "available_at_utc", "source_url", "capture_timestamp", "content_sha256"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "artifact_type": {"const": "phase3_pit_archived_publication"},
    "game": {"enum": ["dlt", "ssq"]},
    "issue_id": {"type": "string", "minLength": 1},
    "front_numbers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "back_numbers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "availability_basis": {"type": "string", "minLength": 1},
    "available_at_utc": {"type": "string", "format": "date-time"},
    "source_url": {"type": "string", "minLength": 1},
    "capture_timestamp": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
