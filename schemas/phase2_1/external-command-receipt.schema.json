{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "command", "status", "terminal", "started_at_utc", "finished_at_utc", "exit_code", "stdout_summary", "stderr_summary", "stdout_sha256", "stderr_sha256", "executed", "network_access", "input_identity"],
  "properties": {
    "schema_version": {"const": "2.1.0"}, "artifact_type": {"const": "phase2_1_external_command_receipt"}, "release_id": {"const": "P2.1-R00-60d02be4dbe9-i05"},
    "command": {"type": "string"}, "status": {"enum": ["PASS", "FAIL"]}, "terminal": {"enum": ["PASS", "FAIL"]},
    "started_at_utc": {"type": "string", "format": "date-time"}, "finished_at_utc": {"type": "string", "format": "date-time"}, "exit_code": {"type": "integer", "minimum": 0},
    "stdout_summary": {"type": "string"}, "stderr_summary": {"type": "string"}, "stdout_sha256": {"pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"pattern": "^[0-9a-f]{64}$"}, "executed": {"const": true}, "network_access": {"const": false},
    "input_identity": {"type": "object", "required": ["release_id", "baseline_sha", "phase1_frozen", "phase2_frozen", "task_inputs", "task_input_aggregate_sha256"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"terminal": {"const": "PASS"}, "exit_code": {"const": 0}}}},
    {"if": {"properties": {"status": {"const": "FAIL"}}}, "then": {"properties": {"terminal": {"const": "FAIL"}, "exit_code": {"minimum": 1}}}}
  ]
}
