{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lottery.local/schemas/phase4/formal-forecast.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "forecast_id", "game", "target_issue", "target_position", "model_release_id",
    "model_path", "model_sha256", "feature_release_id", "feature_manifest_sha256", "data_release_id",
    "data_manifest_sha256", "config_id", "code_commit", "dependency_identity", "training_cutoff_issue",
    "training_cutoff_position", "ticket_count", "prediction_locked_at_utc", "lock_id",
    "distinct_probability_count", "first_probability", "last_probability", "probability_representation",
    "normalization_method", "normalization_proof_path", "normalization_proof_sha256",
    "probability_qualification_path", "probability_qualification_sha256", "joint_probability_mass",
    "strictly_positive_complete_space", "top_prefixes", "tie_fields", "ranking_algorithm_id",
    "ranking_key", "provider_access", "status"
  ],
  "properties": {
    "artifact_type": {"const": "phase4_formal_forecast"}, "forecast_id": {"type": "string"},
    "game": {"enum": ["ssq", "dlt"]}, "target_issue": {"type": "string"}, "target_position": {"type": "integer", "minimum": 1},
    "model_release_id": {"type": "string"}, "model_path": {"type": "string"}, "model_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "feature_release_id": {"type": "string"}, "feature_manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "data_release_id": {"pattern": "^[0-9a-f]{64}$"}, "data_manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "config_id": {"pattern": "^[0-9a-f]{64}$"}, "code_commit": {"pattern": "^[0-9a-f]{40}$"},
    "dependency_identity": {"type": "string"}, "training_cutoff_issue": {"type": "string"},
    "training_cutoff_position": {"type": "integer", "minimum": 0}, "ticket_count": {"const": 1000},
    "prediction_locked_at_utc": {"type": "string", "format": "date-time"}, "lock_id": {"type": "string"},
    "distinct_probability_count": {"type": "integer", "minimum": 2}, "first_probability": {"type": "string"},
    "last_probability": {"type": "string"}, "probability_representation": {"const": "P4-LOGSUMEXP-STABLE-SCORE-KEY-1"},
    "normalization_method": {"const": "complete_enumeration_streaming_log_sum_exp_v1"},
    "normalization_proof_path": {"type": "string"}, "normalization_proof_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "probability_qualification_path": {"type": "string"}, "probability_qualification_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "joint_probability_mass": {"const": 1.0}, "strictly_positive_complete_space": {"const": true},
    "top_prefixes": {"type": "object"}, "tie_fields": {"type": "array", "minItems": 6},
    "ranking_algorithm_id": {"const": "joint_stable_score_key_desc_tie_canonical_ticket_asc_v1"},
    "ranking_key": {"const": ["stable_score_order_key_desc_P4S10HE1", "canonical_ticket_asc_within_stable_score_key_tie"]}, "provider_access": {"type": "array", "minItems": 1},
    "status": {"const": "locked_unscored"}
  }
}
