{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "status", "created_at_utc", "profile", "file_count", "files", "inventory_sha256", "input_identity"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "artifact_type": {"const": "phase2_1_recursive_evidence_manifest"},
    "release_id": {"const": "P2.1-R00-61a99a2c3732-i07"},
    "status": {"const": "frozen"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "profile": {"type": "string"},
    "file_count": {"type": "integer", "minimum": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}}},
    "inventory_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "input_identity": {"type": "object", "required": ["release_id", "baseline_sha", "phase1_frozen", "phase2_frozen", "task_inputs", "task_input_aggregate_sha256"]}
  }
}
