{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoresearch-lotte:phase0:p0-06-scheduler-install-audit:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "recorded_at_utc", "task_name", "scope", "runtime_plan_sha256", "installed", "matches_frozen_plan", "checks", "trigger_count", "next_run_local", "last_run_state", "last_task_result", "missed_runs", "soak_log_bytes", "evidence_manifest_sha256", "evidence_manifest_last_write_utc", "verify_command", "exit_code", "os_state_claim_scope"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "p0_06_scheduler_install_audit"},
    "contract_version": {"const": "1.3"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "task_name": {"const": "AutoresearchLotte-P0-06"},
    "scope": {"const": "current_user"},
    "runtime_plan_sha256": {"$ref": "#/$defs/hash"},
    "installed": {"type": "boolean"},
    "matches_frozen_plan": {"type": "boolean"},
    "checks": {"$ref": "#/$defs/checks"},
    "trigger_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "next_run_local": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+08:00$"},
    "last_run_state": {"enum": ["never_run", "has_run"]},
    "last_task_result": {"type": "integer"},
    "missed_runs": {"type": "integer", "minimum": 0},
    "soak_log_bytes": {"type": "integer", "minimum": 0},
    "evidence_manifest_sha256": {"$ref": "#/$defs/hash"},
    "evidence_manifest_last_write_utc": {"type": "string", "format": "date-time"},
    "verify_command": {"type": "string", "minLength": 1},
    "exit_code": {"type": "integer"},
    "os_state_claim_scope": {"const": "point_in_time_snapshot_not_continuous_os_proof"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ActionCountOne", "ExecuteExact", "ArgumentsExact", "WorkingDirectoryExact", "TriggerCount24", "TriggerTimesExact", "StartWhenAvailable", "ExecutionTimeLimit15Minutes", "MultipleInstancesIgnoreNew", "PrincipalCurrentSid", "PrincipalInteractive", "PrincipalLimited"],
      "properties": {
        "ActionCountOne": {"type": "boolean"}, "ExecuteExact": {"type": "boolean"}, "ArgumentsExact": {"type": "boolean"}, "WorkingDirectoryExact": {"type": "boolean"},
        "TriggerCount24": {"type": "boolean"}, "TriggerTimesExact": {"type": "boolean"}, "StartWhenAvailable": {"type": "boolean"}, "ExecutionTimeLimit15Minutes": {"type": "boolean"},
        "MultipleInstancesIgnoreNew": {"type": "boolean"}, "PrincipalCurrentSid": {"type": "boolean"}, "PrincipalInteractive": {"type": "boolean"}, "PrincipalLimited": {"type": "boolean"}
      }
    }
  }
}
