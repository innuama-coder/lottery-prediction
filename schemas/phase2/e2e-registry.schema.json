{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2-e2e-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "status", "created_at_utc", "verdicts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase2_e2e_registry"},
    "status": {"enum": ["PASS", "PENDING"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "verdicts": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "expected", "observed", "receipt"], "properties": {"id": {"type": "string", "pattern": "^E2E-P2-[0-9]{2}-.+$"}, "status": {"enum": ["PASS", "PENDING"]}, "expected": {"$ref": "#/$defs/outcome"}, "observed": {"anyOf": [{"$ref": "#/$defs/outcome"}, {"type": "null"}]}, "receipt": {"anyOf": [{"$ref": "#/$defs/pathHash"}, {"type": "null"}]}}}}
  },
  "$defs": {
    "outcome": {"type": "object", "additionalProperties": false, "required": ["exit_code", "terminal"], "properties": {"exit_code": {"type": "integer"}, "terminal": {"type": "string", "minLength": 1}}},
    "pathHash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
