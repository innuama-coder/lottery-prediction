{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "results_blind", "implementation_identity", "features", "forbidden_feature_families"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "artifact_type": {"const": "phase3_feature_registry"},
    "results_blind": {"const": true},
    "implementation_identity": {"type":"object","additionalProperties":false,"required":["source_path","source_sha256","data_time_contract_sha256"],"properties":{"source_path":{"const":"src/lottery_research/phase3/formal.py"},"source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"data_time_contract_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "features": {"type": "object", "additionalProperties": {"$ref": "#/$defs/feature"}},
    "forbidden_feature_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "definition", "raw_fields", "window", "games", "rule_scope", "availability_proof", "missing_policy", "fit_scope", "leakage_tests", "ablation_group", "status"],
      "properties": {
        "feature_id": {"type": "string"}, "definition": {"type": "string"},
        "raw_fields": {"type": "array", "items": {"type": "string"}}, "window": {"type": "string"},
        "games": {"type": "array", "items": {"enum": ["dlt", "ssq"]}, "uniqueItems": true},
        "rule_scope": {"type": "array", "items": {"type": "string"}},
        "availability_proof": {"type": "object", "additionalProperties": false, "required": ["mode", "rule", "ledger_path"], "properties": {"mode": {"const": "retrospective_sequence_safe"}, "rule": {"const": "source_issue_strictly_before_target_issue"}, "ledger_path": {"const": "config/phase3/availability-ledger.json"}}}, "missing_policy": {"const": "fail_closed"},
        "fit_scope": {"type": "string"}, "leakage_tests": {"type": "array", "items": {"type": "string"}},
        "ablation_group": {"type": "string"}, "status": {"enum": ["eligible", "ineligible", "blocked_pending_external_time_evidence"]}
      }
    }
  }
}
