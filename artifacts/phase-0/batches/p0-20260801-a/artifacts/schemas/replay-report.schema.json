{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:autoresearch-lotte:phase0:replay-report:1.0.0","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","contract_version","started_at_utc","completed_at_utc","reviewer_id","clean_environment","verification_command_sha256","input_manifest_sha256","output_manifest_sha256","exit_code","gate_results","deterministic_match"],
  "properties":{"schema_version":{"const":"1.0.0"},"artifact_type":{"const":"replay_report"},"contract_version":{"const":"1.3"},"started_at_utc":{"type":"string","format":"date-time"},"completed_at_utc":{"type":"string","format":"date-time"},"reviewer_id":{"type":"string","minLength":1},"clean_environment":{"const":true},"verification_command_sha256":{"$ref":"#/$defs/hash"},"input_manifest_sha256":{"$ref":"#/$defs/hash"},"output_manifest_sha256":{"$ref":"#/$defs/hash"},"exit_code":{"type":"integer"},"gate_results":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/gate"}},"deterministic_match":{"type":"boolean"}},
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"gate":{"type":"object","additionalProperties":false,"required":["gate_id","outcome","evidence_refs","reason"],"properties":{"gate_id":{"enum":["G-SCOPE","G-AUTHORITY","G-COMPLIANCE","G-SCHEMA","G-PROVENANCE","G-RULES","G-TIME","G-PARSE","G-CORRECTNESS","G-COVERAGE","G-REVISION","G-RECOVERY","G-REPRODUCIBILITY","G-HANDOFF"]},"outcome":{"enum":["PASS","FAIL"]},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"reason":{"type":"string","minLength":1}}}}
}
