{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/phase2.1/contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "run_label", "baseline_sha", "release_id", "iteration", "supersedes_rejected_release", "status", "resource_policy", "source_identity", "task_input_identities", "expected_formal_historical_result_count", "frozen_inputs", "registered_games", "registered_families", "effect_grids", "sample_size_grid", "formal_sequence", "external_verification_commands", "gates", "e2e_cases", "e2e_case_contract", "scientific_classification"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "artifact_type": {"const": "phase2_1_acceptance_contract"},
    "run_label": {"const": "P2.1-R00"},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_id": {"const": "P2.1-R00-61a99a2c3732-i07"},
    "iteration": {"const": "i07"},
    "supersedes_rejected_release": {"const": "P2.1-R00-60d02be4dbe9-i06"},
    "status": {"const": "frozen"},
    "resource_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["capacity_owner", "preflight_mode", "generic_thresholds", "failure_rule"],
      "properties": {
        "capacity_owner": {"const": "task_initiator"},
        "preflight_mode": {"const": "facts_only"},
        "generic_thresholds": {"type": "array", "maxItems": 0},
        "failure_rule": {"const": "only_reproducible_actual_command_benchmark_wheelhouse_test_or_formal_run_errors"}
      }
    },
    "source_identity": {"type": "object", "required": ["baseline_sha_rule", "bundle_digest_profile"]},
    "task_input_identities": {"type": "object", "required": ["prompt.md", "iteration-01.md", "iteration-02.md", "iteration-03.md", "iteration-04.md", "iteration-05.md", "iteration-06.md", "iteration-07.md", "iteration-07-run-02-correction.md"], "additionalProperties": false, "patternProperties": {".*": {"pattern": "^[0-9a-f]{64}$"}}},
    "expected_formal_historical_result_count": {"const": 0},
    "frozen_inputs": {"type": "array", "minItems": 3, "items": {"type": "string"}, "uniqueItems": true},
    "registered_games": {"const": ["dlt", "ssq"]},
    "registered_families": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["marginal_inclusion", "set_structure", "pair_dependence", "slow_drift", "cross_zone_dependence"]}},
    "effect_grids": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "array", "minItems": 4, "items": {"type": "number", "minimum": 0}, "uniqueItems": true}},
    "sample_size_grid": {"const": [50, 100, 200, 500, 1000, 2000]},
    "formal_sequence": {"const": ["readiness", "G0", "G1", "method_review", "qualification", "audit", "power", "replay", "replay_review", "e2e", "logs", "negative_suite", "acceptance"]},
    "external_verification_commands": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "order", "command", "working_directory_scope", "offline_policy", "expected_status", "expected_exit_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1, "maximum": 5},
          "command": {"type": "string", "minLength": 1},
          "working_directory_scope": {"const": "project_root"},
          "offline_policy": {"const": "no_network_frozen_inputs_local_dependencies"},
          "expected_status": {"const": "PASS"},
          "expected_exit_code": {"const": 0}
        }
      }
    },
    "gates": {"type": "object", "required": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"], "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "e2e_cases": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "e2e_case_contract": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "expected_terminal", "scenario", "production_operation", "command", "expected_exit_code_class", "receipt_required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "expected_terminal": {"enum": ["PASS", "READY", "EVIDENCE_MISMATCH", "INVALID_CONTRACT", "ENVIRONMENT_FAILURE"]},
          "scenario": {"type": "string", "minLength": 1},
          "production_operation": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "expected_exit_code_class": {"enum": ["zero", "nonzero"]},
          "receipt_required": {"const": true}
        }
      }
    },
    "scientific_classification": {"type": "object", "required": ["enum", "indeterminate_meaning"], "properties": {"enum": {"const": ["candidate_signal", "no_detectable_signal", "indeterminate"]}, "indeterminate_meaning": {"type": "string", "minLength": 20}}}
  }
}
