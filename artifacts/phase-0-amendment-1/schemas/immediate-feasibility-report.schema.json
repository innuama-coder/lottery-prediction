{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 0 immediate feasibility report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "contract_version", "evaluated_at_utc",
    "input_hashes", "test_runs", "games", "immediate_gates",
    "prospective_observation", "project_decision", "phase0_assessment_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase0_immediate_feasibility_report"},
    "contract_version": {"const": "1.4"},
    "evaluated_at_utc": {"type": "string", "format": "date-time"},
    "input_hashes": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "test_runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "observed_test_count", "result", "stdout_ref", "stderr_ref", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "exit_code": {"type": "integer"},
          "observed_test_count": {"type": "integer", "minimum": 0},
          "result": {"enum": ["PASS", "FAIL"]},
          "stdout_ref": {"type": "string", "minLength": 1},
          "stderr_ref": {"type": "string", "minLength": 1},
          "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "games": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "game", "authoritative_primary", "official_corroborators", "source_topology",
          "independent_conflict_test", "coverage", "modeling_data_sufficient",
          "compliant_corrective_action_available", "alternatives_exhausted_no_evidentiary_path",
          "corrective_actions", "outcome", "blocking_reasons"
        ],
        "properties": {
          "game": {"enum": ["dlt", "ssq"]},
          "authoritative_primary": {"$ref": "#/$defs/source"},
          "official_corroborators": {"type": "array", "items": {"$ref": "#/$defs/source"}},
          "source_topology": {"type": "string", "minLength": 1},
          "independent_conflict_test": {"enum": ["ASSESSABLE", "NOT_ASSESSABLE"]},
          "coverage": {"$ref": "#/$defs/coverage"},
          "modeling_data_sufficient": {"type": "boolean"},
          "compliant_corrective_action_available": {"type": "boolean"},
          "alternatives_exhausted_no_evidentiary_path": {"type": "boolean"},
          "corrective_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "outcome": {"enum": ["PASS_FULL", "PASS_LIMITED", "HOLD", "STOP"]},
          "blocking_reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "immediate_gates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "finding"],
        "properties": {
          "id": {"type": "string", "pattern": "^I-"},
          "status": {"enum": ["PASS", "LIMITATION_RECORDED", "FAIL"]},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "prospective_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "blocking", "evidence_ref"],
      "properties": {
        "classification": {"const": "supplementary_non_blocking"},
        "blocking": {"const": false},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "project_decision": {"enum": ["GO", "LIMITED_GO", "HOLD", "STOP"]},
    "phase0_assessment_status": {"enum": ["COMPLETE", "COMPLETE_WITH_HOLD", "COMPLETE_WITH_STOP"]}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher", "url", "observed_at_utc", "http_status", "access_outcome", "approved_use", "collection_usable_now"],
      "properties": {
        "source_id": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "observed_at_utc": {"type": "string", "format": "date-time"},
        "http_status": {"type": ["integer", "null"]},
        "access_outcome": {"type": "string"},
        "approved_use": {"type": "string"},
        "collection_usable_now": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_expected", "target_observed", "minimum_expected", "minimum_observed", "verified_records", "missing", "declared_coverage_tier", "coverage_tier"],
      "properties": {
        "target_expected": {"type": "integer", "minimum": 0},
        "target_observed": {"type": "integer", "minimum": 0},
        "minimum_expected": {"type": "integer", "minimum": 0},
        "minimum_observed": {"type": "integer", "minimum": 0},
        "verified_records": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "declared_coverage_tier": {"type": "string"},
        "coverage_tier": {"type": "string"}
      }
    }
  }
}
