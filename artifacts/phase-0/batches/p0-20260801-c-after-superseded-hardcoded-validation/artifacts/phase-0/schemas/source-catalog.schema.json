{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoresearch-lotte:phase0:source-catalog:1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "assessed_at_utc", "assessor_id", "assessment_disclaimer", "operational_readiness", "games"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "artifact_type": {"const": "source_catalog"},
    "contract_version": {"const": "1.3"}, "assessed_at_utc": {"type": "string", "format": "date-time"},
    "assessor_id": {"type": "string", "minLength": 1},
    "assessment_disclaimer": {"const": "Engineering access policy assessment; not legal advice."},
    "operational_readiness": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/readiness"}},
    "games": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/game"}}
  },
  "$defs": {
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "authoritative_primary", "official_corroborators", "channel_availability_assessed", "shared_upstream_assessment"],
      "properties": {
        "game": {"enum": ["dlt", "ssq"]}, "authoritative_primary": {"$ref": "#/$defs/source"},
        "official_corroborators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "channel_availability_assessed": {"const": true}, "shared_upstream_assessment": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "publisher", "url", "role", "authority_tier", "content_type", "access_method", "historical_query_capability", "observed_access", "approved_use", "compliance_evidence", "rate_policy", "owner", "review_due"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"}, "role": {"enum": ["authoritative_primary", "official_corroborator"]},
        "authority_tier": {"enum": ["A", "B", "C"]}, "content_type": {"type": "string", "minLength": 1},
        "access_method": {"enum": ["public_https_get", "public_https_post"]},
        "historical_query_capability": {"enum": ["full", "limited", "none", "unknown"]},
        "observed_access": {"$ref": "#/$defs/observed_access"},
        "approved_use": {"enum": ["blocked", "pending", "hold_pending", "metadata_only", "scheduled_low_rate_fetch"]},
        "compliance_evidence": {"$ref": "#/$defs/compliance_evidence"}, "rate_policy": {"$ref": "#/$defs/rate_policy"},
        "owner": {"type": "string", "minLength": 1}, "review_due": {"type": "string", "format": "date"}
      }
    },
    "observed_access": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at_utc", "http_status", "outcome", "final_url", "redirect_chain", "requires_login", "captcha_observed", "javascript_required", "token_required", "response_content_type", "access_controls_bypassed", "evidence_refs"],
      "properties": {
        "observed_at_utc": {"type": "string", "format": "date-time"},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "outcome": {"enum": ["accessible", "blocked", "unavailable", "not_tested"]},
        "final_url": {"type": "string", "pattern": "^https://"},
        "redirect_chain": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://"}},
        "requires_login": {"type": "boolean"}, "captcha_observed": {"type": "boolean"},
        "javascript_required": {"type": "boolean"}, "token_required": {"type": "boolean"},
        "response_content_type": {"type": ["string", "null"]}, "access_controls_bypassed": {"const": false},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "compliance_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["terms_status", "terms_refs", "robots_status", "robots_refs", "copyright_status", "copyright_refs", "unresolved_questions"],
      "properties": {
        "terms_status": {"enum": ["allowed", "unclear", "restricted", "not_published"]}, "terms_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "robots_status": {"enum": ["allowed", "unclear", "disallowed", "not_applicable", "not_published", "unreachable"]}, "robots_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "copyright_status": {"enum": ["recorded", "unclear"]}, "copyright_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "rate_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_requests_per_minute", "request_timeout_seconds", "maximum_attempts_per_request", "minimum_backoff_seconds"],
      "properties": {
        "max_requests_per_minute": {"type": "integer", "minimum": 1, "maximum": 60},
        "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "maximum_attempts_per_request": {"type": "integer", "minimum": 1, "maximum": 3},
        "minimum_backoff_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "acquisition_ready", "scheduled_source_ids", "hold_source_ids", "blocked_source_ids", "policy_conclusion"],
      "properties": {
        "game": {"enum": ["dlt", "ssq"]}, "acquisition_ready": {"type": "boolean"},
        "scheduled_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "hold_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blocked_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "policy_conclusion": {"enum": ["ready", "hold", "blocked"]}
      }
    }
  }
}
