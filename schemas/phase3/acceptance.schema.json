{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "iteration_id", "iteration_ordinal", "status", "delivery_status", "scientific_summary", "m0_permanent_champion", "blocking_findings", "manifest_sha256", "formal_run_authorized", "actor_assignment_sha256", "implementation_author_id", "classification_approver_id", "approver_task_id", "approver_session_id", "approver_task_record_sha256", "accepted_at_utc"],
  "properties": {
    "schema_version": {"const": "3.0.0"}, "artifact_type": {"const": "phase3_acceptance"},
    "release_id": {"type": "string", "pattern": "^(?!.*latest)(?!.*\\*).+$"}, "iteration_id": {"type": "string"}, "iteration_ordinal": {"type": "integer", "minimum": 1, "maximum": 2},
    "status": {"enum": ["PASS", "HOLD", "FAIL"]}, "delivery_status": {"enum": ["GO", "HOLD", "STOP"]},
    "scientific_summary": {"enum": ["no_shadow_candidate", "indeterminate", "shadow_candidate"]},
    "m0_permanent_champion": {"const": true}, "blocking_findings": {"type": "integer", "minimum": 0},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "formal_run_authorized": {"type": "boolean"},
    "actor_assignment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_author_id": {"type": "string", "minLength": 1}, "classification_approver_id": {"type": "string", "minLength": 1},
    "approver_task_id": {"type": "string", "minLength": 1}, "approver_session_id": {"type": "string", "minLength": 1},
    "approver_task_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "accepted_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"delivery_status": {"const": "GO"}, "formal_run_authorized": {"const": true}, "blocking_findings": {"const": 0}}}}]
}
