{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2-e2e-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "case_id", "owner", "gate", "status", "isolated_root", "started_at_utc", "finished_at_utc", "expected", "observed", "run_identities", "assertions", "input_identities", "output_identities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase2_e2e_receipt"},
    "case_id": {"type": "string", "pattern": "^E2E-P2-[0-9]{2}-.+$"},
    "owner": {"type": "string", "minLength": 1},
    "gate": {"type": "string", "pattern": "^G[0-6]$"},
    "status": {"const": "PASS"},
    "isolated_root": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "expected": {"$ref": "#/$defs/outcome"},
    "observed": {"$ref": "#/$defs/outcome"},
    "run_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathHash"}},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "expected", "observed"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"const": "PASS"}, "expected": {}, "observed": {}}}},
    "input_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathHash"}},
    "output_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathHash"}}
  },
  "$defs": {
    "outcome": {"type": "object", "additionalProperties": false, "required": ["exit_code", "terminal"], "properties": {"exit_code": {"type": "integer"}, "terminal": {"type": "string", "minLength": 1}}},
    "pathHash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
