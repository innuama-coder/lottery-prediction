{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 0 compliant corrective path assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "assessed_at_utc", "games"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase0_corrective_path_assessment"},
    "contract_version": {"const": "1.4"},
    "assessed_at_utc": {"type": "string", "format": "date-time"},
    "games": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "game", "compliant_corrective_action_available",
          "alternatives_exhausted_no_evidentiary_path", "rationale", "actions",
          "audited_alternatives", "exhaustion_evidence_refs"
        ],
        "properties": {
          "game": {"enum": ["dlt", "ssq"]},
          "compliant_corrective_action_available": {"type": "boolean"},
          "alternatives_exhausted_no_evidentiary_path": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1},
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "description", "evidence_refs", "acceptance_condition"],
              "properties": {
                "action_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "acceptance_condition": {"type": "string", "minLength": 1}
              }
            }
          },
          "audited_alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["alternative_id", "description", "status", "evidence_refs"],
              "properties": {
                "alternative_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "status": {"enum": ["available", "hold", "blocked", "exhausted"]},
                "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "exhaustion_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
