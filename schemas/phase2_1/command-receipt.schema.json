{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "command", "argv", "status", "terminal", "exit_code", "started_at_utc", "finished_at_utc", "working_directory", "executed", "network_access", "stdout_summary", "stderr_summary", "stdout_sha256", "stderr_sha256", "input_identity"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "artifact_type": {"const": "phase2_1_command_record"},
    "release_id": {"const": "P2.1-R00-61a99a2c3732-i07-r02"},
    "command": {"type": "string"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["PASS", "FAIL"]},
    "terminal": {"enum": ["PASS", "READY", "frozen", "FAIL", "EVIDENCE_MISMATCH", "INVALID_CONTRACT", "ENVIRONMENT_FAILURE"]},
    "exit_code": {"type": "integer", "minimum": 0},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "working_directory": {"type": "string"},
    "executed": {"const": true},
    "network_access": {"const": false},
    "stdout_summary": {"type": "string"},
    "stderr_summary": {"type": "string"},
    "stdout_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "input_identity": {"type": "object", "required": ["release_id", "baseline_sha", "phase1_frozen", "phase2_frozen", "task_inputs", "task_input_aggregate_sha256"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"exit_code": {"const": 0}, "terminal": {"enum": ["PASS", "READY", "frozen"]}}}},
    {"if": {"properties": {"status": {"const": "FAIL"}}}, "then": {"properties": {"exit_code": {"minimum": 1}, "terminal": {"enum": ["FAIL", "EVIDENCE_MISMATCH", "INVALID_CONTRACT", "ENVIRONMENT_FAILURE"]}}}}
  ]
}
