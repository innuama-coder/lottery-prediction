{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lottery.local/schemas/phase4/local-verifier-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_id", "supported_runtime", "score_order_contract", "default_numeric_profile", "numeric_profiles", "path_numeric_profiles", "numeric_profile_evidence", "exact_invariants", "historical_formal_evidence"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "artifact_type": {"const": "phase4_local_verifier_contract"},
    "contract_id": {"const": "P4-LOCAL-STABLE-SCORE-KEY-2"},
    "supported_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "python_major_minor", "patch_release_portable", "platform_portable"],
      "properties": {
        "implementation": {"const": "CPython"},
        "python_major_minor": {"const": "3.12"},
        "patch_release_portable": {"const": true},
        "platform_portable": {"const": true}
      }
    },
    "score_order_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_order_key_id", "canonical_source", "quantum", "rounding", "ranking", "identity_fields_exact", "observed_cross_runtime_score_drift", "preserved_r10_minimum_adjacent_distinct_gap", "resolution_rationale"],
      "properties": {
        "score_order_key_id": {"const": "P4S10HE1"},
        "canonical_source": {"const": "exact finite binary64 value converted to an exact decimal rational"},
        "quantum": {"const": "0.0000000001"},
        "rounding": {"const": "ROUND_HALF_EVEN"},
        "ranking": {"const": ["stable_score_order_key_desc", "canonical_ticket_asc_within_stable_score_key_tie"]},
        "identity_fields_exact": {"const": ["score_order_key", "score_identity", "tie_key", "tie_group_id", "probability_layer", "tie_group_size", "tie_rank_lower", "tie_rank_upper", "tie_midrank"]},
        "observed_cross_runtime_score_drift": {"const": "2.8e-17"},
        "preserved_r10_minimum_adjacent_distinct_gap": {"const": "4.326295779955025012e-10"},
        "resolution_rationale": {"type": "string", "minLength": 120}
      }
    },
    "default_numeric_profile": {"const": "tight_recomputed_v1"},
    "numeric_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tight_recomputed_v1", "derived_feature_snapshot_v1", "top1000_derived_probability_display_v1"],
      "properties": {
        "tight_recomputed_v1": {"$ref": "#/$defs/tightProfile"},
        "derived_feature_snapshot_v1": {"$ref": "#/$defs/derivedFeatureProfile"},
        "top1000_derived_probability_display_v1": {"$ref": "#/$defs/top1000DerivedProbabilityDisplayProfile"}
      }
    },
    "path_numeric_profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "paths"],
        "properties": {
          "profile_id": {"enum": ["tight_recomputed_v1", "derived_feature_snapshot_v1", "top1000_derived_probability_display_v1"]},
          "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "not": {"pattern": "\\*\\*"}}}
        }
      }
    },
    "numeric_profile_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_feature_snapshot_v1", "top1000_derived_probability_display_v1"],
      "properties": {
        "derived_feature_snapshot_v1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture_path", "observed_difference_count", "observed_max_absolute", "observed_max_relative", "observed_max_ulps", "ceiling_rationale"],
          "properties": {
            "fixture_path": {"const": "tests/phase4/fixtures/local-verifier-feature-snapshot-macos-31211.json"},
            "observed_difference_count": {"const": 32},
            "observed_max_absolute": {"const": 2.62e-16},
            "observed_max_relative": {"const": 2.64e-14},
            "observed_max_ulps": {"const": 151},
            "ceiling_rationale": {"type": "string", "minLength": 40}
          }
        },
        "top1000_derived_probability_display_v1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture_path", "observed_path", "observed_max_absolute", "observed_max_relative", "observed_max_ulps", "ceiling_rationale"],
          "properties": {
            "fixture_path": {"const": "tests/phase4/fixtures/local-verifier-top1000-probability-macos-31211.json"},
            "observed_path": {"const": "top1000.622.joint_probability"},
            "observed_max_absolute": {"const": 2.2499312661442353e-22},
            "observed_max_relative": {"const": 3.5383660753807325e-15},
            "observed_max_ulps": {"const": 17},
            "ceiling_rationale": {"type": "string", "minLength": 40}
          }
        }
      }
    },
    "exact_invariants": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "historical_formal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase2_receipt", "phase2_1_receipt", "local_reexecution_required"],
      "properties": {
        "phase2_receipt": {"const": "validation/attempts/A06-phase2/receipt.json"},
        "phase2_1_receipt": {"const": "validation/attempts/A05-phase2-1/receipt.json"},
        "local_reexecution_required": {"const": false}
      }
    }
  },
  "$defs": {
    "tightProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finite_required", "require_all_bounds", "max_absolute", "max_relative", "max_ulps"],
      "properties": {
        "finite_required": {"const": true},
        "require_all_bounds": {"const": true},
        "max_absolute": {"const": 1e-12},
        "max_relative": {"const": 1e-12},
        "max_ulps": {"const": 8}
      }
    },
    "derivedFeatureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finite_required", "require_all_bounds", "max_absolute", "max_relative", "max_ulps"],
      "properties": {
        "finite_required": {"const": true},
        "require_all_bounds": {"const": true},
        "max_absolute": {"const": 3e-16},
        "max_relative": {"const": 3e-14},
        "max_ulps": {"const": 151}
      }
    },
    "top1000DerivedProbabilityDisplayProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finite_required", "require_all_bounds", "max_absolute", "max_relative", "max_ulps"],
      "properties": {
        "finite_required": {"const": true},
        "require_all_bounds": {"const": true},
        "max_absolute": {"const": 2.2499312661442353e-22},
        "max_relative": {"const": 3.5383660753807325e-15},
        "max_ulps": {"const": 17}
      }
    }
  }
}
