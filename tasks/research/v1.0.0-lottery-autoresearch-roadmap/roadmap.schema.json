{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lottery-autoresearch-roadmap.schema.json",
  "title": "Lottery Autoresearch Tooling-Independent Research Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "roadmap_id",
    "status",
    "tooling_independent",
    "purpose",
    "current_boundary",
    "source_documents",
    "global_principles",
    "task_state_contract",
    "game_scope_contract",
    "terminal_flow",
    "stages",
    "tasks",
    "dag",
    "phase_0_coverage",
    "final_acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "schema_path": {
      "type": "string",
      "minLength": 1
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "ready_to_start_task_001_p0_01"
      ]
    },
    "tooling_independent": {
      "const": true
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "current_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "truth_statement"
      ],
      "properties": {
        "included": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "excluded": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "truth_statement": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source_documents": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "global_principles": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "task_state_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "allowed_transitions",
        "terminal_evidence_rule",
        "resume_rule"
      ],
      "properties": {
        "states": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "allowed_transitions": {
          "type": "object"
        },
        "terminal_evidence_rule": {
          "type": "string",
          "minLength": 20
        },
        "resume_rule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "game_scope_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_task",
        "source_evidence",
        "games",
        "eligible_outcomes",
        "derivation",
        "downstream_rule",
        "zero_active_games_rule"
      ],
      "properties": {
        "source_task": { "const": "TASK-001" },
        "source_evidence": { "type": "string", "minLength": 1 },
        "games": { "$ref": "#/$defs/nonEmptyStrings" },
        "eligible_outcomes": { "$ref": "#/$defs/nonEmptyStrings" },
        "derivation": { "type": "string", "minLength": 20 },
        "downstream_rule": { "type": "string", "minLength": 20 },
        "zero_active_games_rule": { "type": "string", "minLength": 20 }
      }
    },
    "terminal_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalizer_task",
        "state_record_path_template",
        "normal_entry",
        "short_circuit_entry",
        "finalizer_rule",
        "skip_record_required_fields"
      ],
      "properties": {
        "finalizer_task": { "const": "TASK-999" },
        "state_record_path_template": { "const": "artifacts/research/task-states/{run_id}/{task_id}.json" },
        "normal_entry": { "type": "string", "minLength": 10 },
        "short_circuit_entry": { "type": "string", "minLength": 10 },
        "finalizer_rule": { "type": "string", "minLength": 10 },
        "skip_record_required_fields": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "plain_language_goal",
          "task_ids",
          "exit"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^R[0-9G]$"
          },
          "plain_language_goal": {
            "type": "string",
            "minLength": 10
          },
          "task_ids": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "exit": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "dag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edges",
        "finalizer_edges",
        "execution_order"
      ],
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "finalizer_edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "mode",
              "reason"
            ],
            "properties": {
              "from": { "type": "string" },
              "to": { "const": "TASK-999" },
              "mode": { "const": "completion_or_terminal" },
              "reason": { "type": "string", "minLength": 8 }
            }
          }
        },
        "execution_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyStrings"
          }
        }
      }
    },
    "phase_0_coverage": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_package",
          "task_id",
          "artifact_keys",
          "gate_ids"
        ],
        "properties": {
          "work_package": {
            "type": "string",
            "pattern": "^P0-0[1-7]$"
          },
          "task_id": {
            "const": "TASK-001"
          },
          "artifact_keys": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "gate_ids": {
            "$ref": "#/$defs/nonEmptyStrings"
          }
        }
      }
    },
    "final_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "decision_logic",
        "go_means",
        "go_does_not_mean",
        "required_evidence"
      ],
      "properties": {
        "task_id": {
          "const": "TASK-999"
        },
        "decision_logic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation_order",
            "STOP",
            "GO",
            "HOLD",
            "uniqueness_rule"
          ],
          "properties": {
            "evaluation_order": {
              "type": "array",
              "prefixItems": [
                { "const": "STOP" },
                { "const": "GO" },
                { "const": "HOLD" }
              ],
              "items": false
            },
            "STOP": { "type": "string", "minLength": 10 },
            "GO": { "type": "string", "minLength": 10 },
            "HOLD": { "type": "string", "minLength": 10 },
            "uniqueness_rule": { "type": "string", "minLength": 10 }
          }
        },
        "go_means": {
          "type": "string",
          "minLength": 10
        },
        "go_does_not_mean": {
          "type": "string",
          "minLength": 10
        },
        "required_evidence": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criterion",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{3}-AC-[0-9]{2}$"
        },
        "criterion": {
          "type": "string",
          "minLength": 10
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command",
        "availability",
        "covers_acceptance_ids",
        "pass_condition"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 10
        },
        "availability": {
          "enum": [
            "available_now",
            "created_by_this_task"
          ]
        },
        "covers_acceptance_ids": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "pass_condition": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "stage_id",
        "title",
        "plain_language_goal",
        "work_kind",
        "status",
        "dependencies",
        "source_refs",
        "game_scope",
        "review",
        "execution",
        "entry_conditions",
        "output_paths",
        "allowed_scope",
        "forbidden_scope",
        "steps",
        "acceptance",
        "verification",
        "stop_conditions",
        "handoff"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{3}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^R[0-9G]$"
        },
        "title": {
          "type": "string",
          "minLength": 4
        },
        "plain_language_goal": {
          "type": "string",
          "minLength": 10
        },
        "work_kind": {
          "enum": [
            "data_feasibility_execution",
            "research_contract",
            "empirical_research",
            "research_protocol",
            "research_design",
            "architecture_protocol",
            "benchmark_protocol",
            "prospective_protocol",
            "research_acceptance"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "passed",
            "held",
            "stopped",
            "skipped_terminal"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "finalizer_dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "dependency_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "normal_requires",
            "short_circuit_requires",
            "evidence_source"
          ],
          "properties": {
            "mode": { "const": "all_passed_or_terminal_short_circuit" },
            "normal_requires": { "type": "string", "minLength": 10 },
            "short_circuit_requires": { "type": "string", "minLength": 10 },
            "evidence_source": { "type": "string", "minLength": 10 }
          }
        },
        "source_refs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "game_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["producer", "consumer"] },
            "input_evidence": { "type": "string", "minLength": 1 },
            "output_evidence": { "type": "string", "minLength": 1 },
            "required_fields": { "$ref": "#/$defs/nonEmptyStrings" },
            "output_rule": { "type": "string", "minLength": 20 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_role",
            "reviewer_role",
            "identity_freeze",
            "independence_rule",
            "attestation_path"
          ],
          "properties": {
            "owner_role": { "type": "string", "minLength": 4 },
            "reviewer_role": { "type": "string", "minLength": 4 },
            "identity_freeze": { "type": "string", "minLength": 8 },
            "independence_rule": { "type": "string", "minLength": 10 },
            "assignment_path": { "type": "string", "minLength": 1 },
            "attestation_path": { "type": "string", "minLength": 1 }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effort_class",
            "resource_budget_policy",
            "timeout_or_hold_rule"
          ],
          "properties": {
            "effort_class": { "type": "string", "minLength": 4 },
            "resource_budget_policy": { "type": "string", "minLength": 10 },
            "timeout_or_hold_rule": { "type": "string", "minLength": 10 }
          }
        },
        "entry_conditions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "work_packages": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "output_paths": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "required_artifact_keys": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "allowed_scope": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbidden_scope": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "steps": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verification"
          }
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "handoff": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
