{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:autoresearch-lotte:phase0:p0-07-bundle-manifest:1.1.0","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","contract_version","manifest_excludes_itself","files"],
