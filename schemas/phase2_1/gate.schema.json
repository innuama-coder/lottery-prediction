    "release_id": {"const": "P2.1-R00-60d02be4dbe9-i05"},
    "status": {"const": "PASS"},
    "gates": {"const": {"G0": "PASS", "G1": "PASS"}},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "readiness_identity": {"type": "object", "required": ["path", "sha256"]},
    "input_identity": {"type": "object", "required": ["release_id", "baseline_sha", "phase1_frozen", "phase2_frozen", "task_inputs", "task_input_aggregate_sha256"]},
    "checks": {"type": "object", "additionalProperties": {"const": "PASS"}}
