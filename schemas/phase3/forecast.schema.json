{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","release_id","run_id","game","target_issue","model_id","prediction_locked_at","training_cutoff","training_count","inner_target_issues","distribution","normalization_sum","top_1000_role","top_1000_path","top_1000_sha256","label_read"],
  "properties":{
    "schema_version":{"const":"3.0.0"},"artifact_type":{"const":"phase3_forecast"},
    "release_id":{"type":"string","pattern":"^(?!.*latest)(?!.*\\*).+$"},"run_id":{"type":"string","minLength":1},
    "game":{"enum":["dlt","ssq"]},"target_issue":{"type":"string"},"model_id":{"enum":["M0","M1"]},
    "prediction_locked_at":{"type":"string","format":"date-time"},"training_cutoff":{"type":"string"},
    "training_count":{"type":"integer","minimum":50,"maximum":199},"inner_target_issues":{"type":"array","items":{"type":"string"},"maxItems":20,"uniqueItems":true},
    "distribution":{"type":"object","additionalProperties":false,"required":["front","back","selected_lambda","partition_independence"],"properties":{
      "front":{"$ref":"#/$defs/partition"},"back":{"$ref":"#/$defs/partition"},
      "selected_lambda":{"type":["number","null"],"enum":[null,1.0,5.0,20.0,100.0]},"partition_independence":{"const":true}
    }},
    "normalization_sum":{"type":"number","minimum":0.999999999999,"maximum":1.000000000001},
    "top_1000_role":{"const":"diagnostic_only"},"top_1000_path":{"type":"string","pattern":"^(?!/)(?!.*latest)(?!.*\\*).+$"},
    "top_1000_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"label_read":{"const":false}
  },
  "$defs":{"partition":{"type":"object","additionalProperties":false,"required":["size","cardinality","weights","inclusion_probabilities"],"properties":{
    "size":{"type":"integer","minimum":1},"cardinality":{"type":"integer","minimum":1},
    "weights":{"type":"array","minItems":1,"items":{"type":"number","exclusiveMinimum":0}},
    "inclusion_probabilities":{"type":"array","minItems":1,"items":{"type":"number","minimum":0,"maximum":1}}
  }}}
}
