{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoresearch-lotte:phase0:observation-plan:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "freeze_id", "frozen_at_utc", "frozen_by", "acceptance_cutoff_utc", "request_timeout_seconds", "clock", "budgets", "retry_policy", "games", "request_schedule", "request_schedule_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "observation_plan"}, "contract_version": {"const": "1.3"},
    "freeze_id": {"type": "string", "pattern": "^P0-01-[A-Za-z0-9._-]+$"}, "frozen_at_utc": {"type": "string", "format": "date-time"}, "frozen_by": {"type": "string", "minLength": 1},
    "acceptance_cutoff_utc": {"type": "string", "format": "date-time"}, "request_timeout_seconds": {"const": 20},
    "clock": {"$ref": "#/$defs/clock"}, "budgets": {"$ref": "#/$defs/budgets"}, "retry_policy": {"$ref": "#/$defs/retry"},
    "games": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/game_plan"}},
    "request_schedule": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/request"}},
    "request_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "clock": {"type": "object", "additionalProperties": false, "required": ["source", "check_command", "maximum_offset_seconds", "check_before_each_run", "on_excess_offset"], "properties": {"source": {"type": "string", "minLength": 1}, "check_command": {"type": "string", "minLength": 1}, "maximum_offset_seconds": {"type": "integer", "minimum": 0}, "check_before_each_run": {"const": true}, "on_excess_offset": {"const": "invalidate_run_and_emit_no_verified_records"}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["total_request_limit", "max_requests_per_minute", "total_retry_limit", "storage_bytes", "compute_seconds", "manual_review_minutes"], "properties": {"total_request_limit": {"type": "integer", "minimum": 1}, "max_requests_per_minute": {"type": "integer", "minimum": 1}, "total_retry_limit": {"type": "integer", "minimum": 0}, "storage_bytes": {"type": "integer", "minimum": 1}, "compute_seconds": {"type": "integer", "minimum": 1}, "manual_review_minutes": {"type": "integer", "minimum": 1}}},
    "retry": {"type": "object", "additionalProperties": false, "required": ["maximum_attempts_per_request", "backoff_seconds", "retryable_conditions", "budgets_immutable_after_observation"], "properties": {"maximum_attempts_per_request": {"type": "integer", "minimum": 1}, "backoff_seconds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "retryable_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["timeout", "connection_error", "http_429", "http_5xx"]}}, "budgets_immutable_after_observation": {"const": true}}},
    "game_plan": {"type": "object", "additionalProperties": false, "required": ["game", "cycle_definition", "minimum_complete_draw_cycles", "planned_draw_count", "planned_request_count", "first_request_at_utc", "last_request_at_utc"], "properties": {"game": {"enum": ["dlt", "ssq"]}, "cycle_definition": {"const": "one_calendar_week_at_the_pre_frozen_official_draw_cadence"}, "minimum_complete_draw_cycles": {"const": 2}, "planned_draw_count": {"const": 6}, "planned_request_count": {"type": "integer", "minimum": 6}, "first_request_at_utc": {"type": "string", "format": "date-time"}, "last_request_at_utc": {"type": "string", "format": "date-time"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["request_id", "game", "scheduled_at_utc", "source_slot", "purpose", "sequence"], "properties": {"request_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9._-]+$"}, "game": {"enum": ["dlt", "ssq"]}, "scheduled_at_utc": {"type": "string", "format": "date-time"}, "source_slot": {"enum": ["authoritative_primary", "official_corroborator_if_available"]}, "purpose": {"enum": ["live_draw_observation", "recovery_check"]}, "sequence": {"type": "integer", "minimum": 1}}}
  }
}
