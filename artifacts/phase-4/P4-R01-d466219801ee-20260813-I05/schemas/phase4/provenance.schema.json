{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lottery.local/schemas/phase4/provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["producer_actor_id", "task_id", "session_id", "source_commit", "path", "role"],
  "properties": {
    "producer_actor_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^T(?:0[0-9]|1[0-9]|2[0-4])$"},
    "session_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"$ref": "#/$defs/safePath"},
    "role": {"type": "string", "minLength": 1}
  },
  "$defs": {"safePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*latest)(?!.*\\*).+$"}}
}
