{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:autoresearch-lotte:phase0:reviewer-assignment:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "freeze_id", "frozen_at_utc", "assigned_by", "reviewers", "role_separation", "independence_declaration"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "reviewer_assignment"}, "contract_version": {"const": "1.3"},
    "freeze_id": {"type": "string", "pattern": "^P0-01-[A-Za-z0-9._-]+$"}, "frozen_at_utc": {"type": "string", "format": "date-time"}, "assigned_by": {"type": "string", "minLength": 1},
    "reviewers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewer"}},
    "role_separation": {"type": "object", "additionalProperties": false, "required": ["executor_ids", "parser_author_ids", "reviewer_ids", "pairwise_disjoint"], "properties": {"executor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "parser_author_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reviewer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "pairwise_disjoint": {"const": true}}},
    "independence_declaration": {"type": "object", "additionalProperties": false, "required": ["text", "declared_by_reviewer_ids", "declared_at_utc", "attestation_deferred_to_p0_07"], "properties": {"text": {"type": "string", "minLength": 1}, "declared_by_reviewer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "declared_at_utc": {"type": "string", "format": "date-time"}, "attestation_deferred_to_p0_07": {"const": true}}}
  },
  "$defs": {"reviewer": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "display_name", "responsibilities", "authored_parser", "will_modify_evidence"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}, "responsibilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["schema_review", "clean_replay", "hash_verification", "gate_review"]}}, "authored_parser": {"const": false}, "will_modify_evidence": {"const": false}}}}
}
