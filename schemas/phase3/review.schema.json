{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "review_id", "actor_assignment_sha256", "reviewer_role", "reviewer_id", "review_task_id", "review_session_id", "review_task_record_sha256", "signed_at_utc", "reviewed_manifest_sha256", "implementation_author_id", "classification_approver_id", "independence_declaration", "reviewed_paths", "blocking_findings", "status"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "artifact_type": {"const": "phase3_review"},
    "review_id": {"type": "string", "minLength": 1},
    "actor_assignment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_role": {"const": "independent_reviewer"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "review_task_id": {"type": "string", "minLength": 1},
    "review_session_id": {"type": "string", "minLength": 1},
    "review_task_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_at_utc": {"type": "string", "format": "date-time"},
    "reviewed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_author_id": {"type": "string", "minLength": 1},
    "classification_approver_id": {"type": "string", "minLength": 1},
    "independence_declaration": {"const": "reviewer_is_not_implementation_author_or_classification_approver"},
    "reviewed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "blocking_findings": {"type": "integer", "minimum": 0},
    "status": {"enum": ["PASS", "HOLD", "FAIL"]}
  }
}
