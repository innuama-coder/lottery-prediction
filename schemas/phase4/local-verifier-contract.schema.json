{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lottery.local/schemas/phase4/local-verifier-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_id", "supported_runtime", "numeric_bounds", "semantic_numeric_paths", "exact_invariants", "historical_formal_evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase4_local_verifier_contract"},
    "contract_id": {"const": "P4-LOCAL-SEMANTIC-BINARY64-1"},
    "supported_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "python_major_minor", "patch_release_portable", "platform_portable"],
      "properties": {
        "implementation": {"const": "CPython"},
        "python_major_minor": {"const": "3.12"},
        "patch_release_portable": {"const": true},
        "platform_portable": {"const": true}
      }
    },
    "numeric_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finite_required", "require_all_bounds", "max_absolute", "max_relative", "max_ulps"],
      "properties": {
        "finite_required": {"const": true},
        "require_all_bounds": {"const": true},
        "max_absolute": {"const": 1e-12},
        "max_relative": {"const": 1e-12},
        "max_ulps": {"const": 8}
      }
    },
    "semantic_numeric_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exact_invariants": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "historical_formal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase2_receipt", "phase2_1_receipt", "local_reexecution_required"],
      "properties": {
        "phase2_receipt": {"const": "validation/attempts/A06-phase2/receipt.json"},
        "phase2_1_receipt": {"const": "validation/attempts/A05-phase2-1/receipt.json"},
        "local_reexecution_required": {"const": false}
      }
    }
  }
}
