{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2-run-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "run_id", "command", "argv", "created_at_utc", "contract_identity", "input_identities", "seed_set_id", "output_path"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase2_run_request"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "command": {"enum": ["validate-input", "qualify-harness", "audit", "power", "replay", "accept"]},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "contract_identity": {"$ref": "#/$defs/pathHash"},
    "input_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathHash"}},
    "seed_set_id": {"type": ["string", "null"]},
    "output_path": {"type": "string", "minLength": 1}
  },
  "$defs": {"pathHash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
