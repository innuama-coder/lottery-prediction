[
  {
    "feature_id": "FREQ_ROLLING_RATE",
    "category": "frequency_omission",
    "name_zh": "滚动出现率",
    "name_en": "rolling occurrence rate",
    "definition": "号码在截止预测时点的最近 W 期内出现的比例。",
    "calculation": "由历史开奖号码对每个号码计算 sum(是否出现)/W；W 必须预先固定，并按前后区分别计算。",
    "zone": "both",
    "lotteries": ["ssq", "dlt"],
    "observability": "可算",
    "evidence": "documented",
    "source": ["https://doi.org/10.1080/01621459.1993.10476320"]
  },
  {
    "feature_id": "FREQ_WAITING_TIME",
    "category": "frequency_omission",
    "name_zh": "距上次出现等待期数",
    "name_en": "waiting time since last appearance",
    "definition": "号码自最近一次出现以来经历的完整开奖期数。",
    "calculation": "从预测截点向前找到号码最近出现期，计算中间未出现的期数；从未出现者记为观察窗长度并另加截尾标志。",
    "zone": "both",
    "lotteries": ["ssq", "dlt"],
    "observability": "可算",
    "evidence": "documented",
    "source": ["https://doi.org/10.1111/1467-985X.00056"]
  },
  {
    "feature_id": "FREQ_UNIFORMITY_RESIDUAL",
    "category": "frequency_omission",
    "name_zh": "边际均匀性标准化残差",
    "name_en": "marginal uniformity standardized residual",
    "definition": "窗口内单号观测次数相对 k/N 理论边际期望的标准化偏差。",
    "calculation": "按无放回 k/N 模型求每号期望与协方差，用观测减期望后按理论标准差缩放；不能把普通独立格 Pearson 公式直接当作整组检验。",
    "zone": "both",
    "lotteries": ["ssq", "dlt"],
    "observability": "可算",
    "evidence": "documented",
    "source": ["https://doi.org/10.1016/0167-7152(93)90141-5"]
  },
  {
    "feature_id": "REL_PAIR_RATE",
    "category": "relation_cooccurrence",
    "name_zh": "号码对共现率",
    "name_en": "pair co-occurrence rate",
    "definition": "两个号码在同一期同区共同出现的历史比例。",
    "calculation": "窗口内统计 unordered pair 同期共现次数除以窗口期数，并可减去超几何模型期望。",
    "zone": "both",
    "lotteries": ["ssq", "dlt"],
    "observability": "可算",
    "evidence": "documented",
    "source": ["https://doi.org/10.1016/0167-7152(93)90141-5"]
  },
  {
