{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2-replay-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "status", "reviewer_identity", "independence_level", "source_run_identities", "replay_run_identities", "deterministic_match_rate", "independent_reference_match_rate", "different_seed_verdict", "blocking_findings", "signature"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase2_replay_review"},
    "status": {"enum": ["PASS", "HOLD", "FAIL"]},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "independence_level": {"enum": ["procedural_agent_independence", "organizational_independence"]},
    "source_run_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathHash"}},
    "replay_run_identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathHash"}},
    "deterministic_match_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "independent_reference_match_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "different_seed_verdict": {"enum": ["compatible", "incompatible", "indeterminate"]},
    "blocking_findings": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": "object", "required": ["signed", "signed_at_utc"], "properties": {"signed": {"const": true}, "signed_at_utc": {"type": "string", "format": "date-time"}}, "additionalProperties": true}
  },
  "$defs": {"pathHash": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
}
