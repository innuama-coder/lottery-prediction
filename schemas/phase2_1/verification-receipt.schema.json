{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "operation", "status", "terminal", "exit_code", "started_at_utc", "finished_at_utc", "error"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "artifact_type": {"const": "phase2_1_verification_receipt"},
    "release_id": {"const": "P2.1-R00-60d02be4dbe9-i02"},
    "operation": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "terminal": {"enum": ["PASS", "EVIDENCE_MISMATCH", "INVALID_CONTRACT", "ENVIRONMENT_FAILURE"]},
    "exit_code": {"type": "integer", "minimum": 0},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "error": {"type": ["string", "null"]}
  }
}
