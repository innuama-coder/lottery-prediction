{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoresearch-lotte:phase0:p0-06-runtime-plan:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "generated_at_utc", "status", "soak_log_path", "plan_hash_sidecar", "frozen_input_canonical_sha256", "request_schedule_sha256", "acceptance_cutoff_utc", "acceptance_cutoff_local", "issue_mapping", "requests", "scheduler", "network_authorization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "p0_06_runtime_plan"},
    "contract_version": {"const": "1.3"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "status": {"const": "prepared_not_started"},
    "soak_log_path": {"const": "artifacts/phase-0/soak-run-log.jsonl"},
    "plan_hash_sidecar": {"const": "artifacts/phase-0/p0-06-runtime-plan.json.sha256"},
    "frozen_input_canonical_sha256": {"type": "object", "additionalProperties": false, "required": ["observation_plan", "source_catalog"], "properties": {"observation_plan": {"$ref": "#/$defs/hash"}, "source_catalog": {"$ref": "#/$defs/hash"}}},
    "request_schedule_sha256": {"$ref": "#/$defs/hash"},
    "acceptance_cutoff_utc": {"const": "2026-08-15T17:00:00Z"},
    "acceptance_cutoff_local": {"const": "2026-08-16T01:00:00+08:00"},
    "issue_mapping": {"$ref": "#/$defs/mapping"},
    "requests": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/request"}},
    "scheduler": {"$ref": "#/$defs/scheduler"},
    "network_authorization": {"$ref": "#/$defs/authorization"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["status", "authorized_request_count", "authorized_request_ids", "scope"], "properties": {"status": {"const": "authorized_by_user_for_frozen_p0_06_schedule"}, "authorized_request_count": {"const": 6}, "authorized_request_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-DLT-[A-Za-z0-9._-]+-CORROBORATOR$"}}, "scope": {"const": "exact_dlt_scheduled_corroborator_requests_only"}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["algorithm_version", "dlt_anchor_issue_id", "dlt_anchor_draw_date", "dlt_rule", "dlt_page_mismatch_action", "ssq_rule", "independent_verification_required", "observation_rule_mapping_scope", "future_rule_inference"], "properties": {"algorithm_version": {"const": "calendar-cadence-anchor-v1"}, "dlt_anchor_issue_id": {"const": "2026050"}, "dlt_anchor_draw_date": {"const": "2026-05-09"}, "dlt_rule": {"const": "increment_issue_by_one_for_each_Mon_Wed_Sat_draw_after_anchor"}, "dlt_page_mismatch_action": {"const": "fail_closed_do_not_auto_remap"}, "ssq_rule": {"const": "conditional_2026088_through_2026093_without_local_primary_anchor"}, "independent_verification_required": {"const": true}, "observation_rule_mapping_scope": {"const": "outside_frozen_historical_mapping_after_2026050"}, "future_rule_inference": {"const": "forbidden"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["request_id", "sequence", "game", "planned_at_utc", "source_slot", "source_id", "approved_use", "execution_policy", "scheduled_issue_id", "mapping_status", "request_url"], "properties": {"request_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9._-]+$"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 24}, "game": {"enum": ["dlt", "ssq"]}, "planned_at_utc": {"type": "string", "format": "date-time"}, "source_slot": {"enum": ["authoritative_primary", "official_corroborator_if_available"]}, "source_id": {"type": "string", "minLength": 1}, "approved_use": {"enum": ["blocked", "scheduled_low_rate_fetch", "hold_pending"]}, "execution_policy": {"enum": ["policy_blocked", "network_attempted", "compliance_hold"]}, "scheduled_issue_id": {"type": "string", "pattern": "^[0-9]{7}$"}, "mapping_status": {"enum": ["expected_from_anchor_not_verified", "conditional_hold"]}, "request_url": {"type": ["string", "null"], "minLength": 1}}},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["request_id", "planned_at_utc", "local_at"], "properties": {"request_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9._-]+$"}, "planned_at_utc": {"type": "string", "format": "date-time"}, "local_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(22:00:00|22:03:00)\\+08:00$"}}},
    "scheduler": {"type": "object", "additionalProperties": false, "required": ["task_name", "scope", "start_when_available", "execution_time_limit_minutes", "multiple_instances", "trigger_count", "triggers", "default_installer_action"], "properties": {"task_name": {"const": "AutoresearchLotte-P0-06"}, "scope": {"const": "current_user"}, "start_when_available": {"const": true}, "execution_time_limit_minutes": {"const": 15}, "multiple_instances": {"const": "IgnoreNew"}, "trigger_count": {"const": 24}, "triggers": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/trigger"}}, "default_installer_action": {"const": "verify"}}}
  }
}
