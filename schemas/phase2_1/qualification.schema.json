{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release_id", "status", "gate", "generator_known_answers", "strong_positive_results", "metrics", "input_identities", "input_identity"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "artifact_type": {"const": "phase2_1_qualification"},
    "release_id": {"type": "string"},
    "status": {"const": "PASS"},
    "gate": {"const": "G2"},
    "generator_known_answers": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "required": ["id", "status"], "properties": {"status": {"const": "PASS"}}}
    },
    "strong_positive_results": {
      "type": "array", "minItems": 10,
      "items": {"type": "object", "required": ["game", "family", "status", "direction_match"], "properties": {"status": {"const": "PASS"}, "direction_match": {"const": true}}}
    },
    "metrics": {
      "type": "object",
      "required": ["known_answer_pass_rate", "strong_positive_recovery_rate", "direction_match_rate", "illegal_generated_combinations"],
      "properties": {"known_answer_pass_rate": {"const": 1.0}, "strong_positive_recovery_rate": {"const": 1.0}, "direction_match_rate": {"const": 1.0}, "illegal_generated_combinations": {"const": 0}}
    },
    "input_identities": {"type": "array", "minItems": 2},
    "input_identity": {"type": "object", "required": ["release_id", "baseline_sha", "phase1_frozen", "phase2_frozen", "task_inputs", "task_input_aggregate_sha256"]}
  }
}
