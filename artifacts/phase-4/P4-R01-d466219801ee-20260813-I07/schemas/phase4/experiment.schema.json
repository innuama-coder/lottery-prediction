{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://lottery.local/schemas/phase4/experiment.schema.json","type":"object","additionalProperties":false,"required":["schema_version","artifact_type","experiment_id","game","decision_id","hypothesis_family","alpha_ordinal","alpha_spent","parent_config_id","canonical_diff","registered_p0_id","registered_p1_id","minimum_look","maximum_look","terminal"],"properties":{"schema_version":{"const":"1.0.0"},"artifact_type":{"const":"phase4_experiment"},"experiment_id":{"type":"string","minLength":1},"game":{"enum":["ssq","dlt"]},"decision_id":{"type":"string","minLength":1},"hypothesis_family":{"enum":["static_parameter","slow_drift_parameter","context_feature"]},"alpha_ordinal":{"type":"integer","minimum":1},"alpha_spent":{"type":"string","pattern":"^0\\.[0-9]+$"},"parent_config_id":{"type":"string","minLength":1},"canonical_diff":{"type":"array","minItems":1,"maxItems":1},"registered_p0_id":{"type":"string","minLength":1},"registered_p1_id":{"type":"string","minLength":1},"minimum_look":{"const":30},"maximum_look":{"const":150},"terminal":{"enum":["shadow_candidate","rejected","archived","failed","timeout","budget_exhausted"]}}}
