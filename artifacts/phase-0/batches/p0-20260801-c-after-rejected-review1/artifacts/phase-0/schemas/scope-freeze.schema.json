{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoresearch-lotte:phase0:scope-freeze:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_version", "freeze_id", "frozen_at_utc", "frozen_by", "source_observation_started", "contract", "games", "corroboration_sample", "status_machine"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "scope_freeze"},
    "contract_version": {"const": "1.3"},
    "freeze_id": {"type": "string", "pattern": "^P0-01-[A-Za-z0-9._-]+$"},
    "frozen_at_utc": {"type": "string", "format": "date-time"},
    "frozen_by": {"type": "string", "minLength": 1},
    "source_observation_started": {"const": false},
    "contract": {"$ref": "#/$defs/hashed_file"},
    "games": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/game_scope"}},
    "corroboration_sample": {"$ref": "#/$defs/sample_design"},
    "status_machine": {"$ref": "#/$defs/status_machine"}
  },
  "$defs": {
    "hashed_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start_issue", "end_issue"],
      "properties": {"start_issue": {"type": "string", "pattern": "^[0-9]{5,12}$"}, "end_issue": {"type": "string", "pattern": "^[0-9]{5,12}$"}}
    },
    "game_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "target_interval", "minimum_viable_interval", "acceptance_cutoff_utc", "freeze_status"],
      "properties": {
        "game": {"enum": ["dlt", "ssq"]},
        "target_interval": {"$ref": "#/$defs/interval"},
        "minimum_viable_interval": {"$ref": "#/$defs/interval"},
        "acceptance_cutoff_utc": {"type": "string", "format": "date-time"},
        "freeze_status": {"const": "frozen"}
      }
    },
    "sample_stratum": {
      "type": "object", "additionalProperties": false,
      "required": ["stratum_id", "candidate_issue_ids", "candidate_universe_sha256", "sample_size", "selected_issue_ids", "selected_issue_ids_sha256", "rationale"],
      "properties": {
        "stratum_id": {"type": "string", "minLength": 1},
        "candidate_issue_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{5,12}$"}},
        "candidate_universe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sample_size": {"type": "integer", "minimum": 1},
        "selected_issue_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{5,12}$"}},
        "selected_issue_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "game_sample": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "strata", "final_selected_issue_ids", "final_selected_issue_ids_sha256"],
      "properties": {
        "game": {"enum": ["dlt", "ssq"]},
        "strata": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample_stratum"}},
        "final_selected_issue_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{5,12}$"}},
        "final_selected_issue_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sample_design": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_timing", "algorithm", "seed", "seed_sha256", "sample_size_rationale", "games"],
      "properties": {
        "selection_timing": {"const": "before_historical_outcome_inspection"},
        "algorithm": {"type": "object", "additionalProperties": false, "required": ["name", "version", "specification"], "properties": {"name": {"const": "sha256_rank"}, "version": {"const": "1.0.0"}, "specification": {"type": "string", "minLength": 1}}},
        "seed": {"const": "20260801"},
        "seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sample_size_rationale": {"type": "string", "minLength": 1},
        "games": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/game_sample"}}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"enum": ["unavailable", "unverified", "verified", "conflicted", "invalid"]}, "to": {"enum": ["unavailable", "unverified", "verified", "conflicted", "invalid"]}}
    },
    "status_machine": {
      "type": "object", "additionalProperties": false,
      "required": ["event_sourced", "historical_events_immutable", "statuses", "allowed_transitions", "transition_required_fields"],
      "properties": {
        "event_sourced": {"const": true},
        "historical_events_immutable": {"const": true},
        "statuses": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["unavailable", "unverified", "verified", "conflicted", "invalid"]}},
        "allowed_transitions": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/transition"}},
        "transition_required_fields": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["evidence_ref", "reason_code", "actor_id", "transitioned_at_utc"]}}
      }
    }
  }
}
