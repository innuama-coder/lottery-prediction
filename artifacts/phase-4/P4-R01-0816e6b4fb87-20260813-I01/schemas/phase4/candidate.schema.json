{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lottery.local/schemas/phase4/candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "candidate_id", "game", "parent_model_id", "parent_config_id", "canonical_diff", "hypothesis_family", "code_identity", "data_release_id", "feature_snapshot_id", "preregistration_id", "qualification_id", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase4_candidate"},
    "candidate_id": {"type": "string", "minLength": 1},
    "game": {"enum": ["ssq", "dlt"]},
    "parent_model_id": {"type": "string", "minLength": 1},
    "parent_config_id": {"type": "string", "minLength": 1},
    "canonical_diff": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/patch"}},
    "hypothesis_family": {"enum": ["static_parameter", "slow_drift_parameter", "context_feature"]},
    "code_identity": {"type": "string", "minLength": 1},
    "data_release_id": {"type": "string", "minLength": 1},
    "feature_snapshot_id": {"type": "string", "minLength": 1},
    "preregistration_id": {"type": "string", "minLength": 1},
    "qualification_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["rejected", "archived", "shadow_candidate", "archived_pending_requalification"]}
  },
  "allOf": [
    {"if": {"properties": {"hypothesis_family": {"const": "static_parameter"}}, "required": ["hypothesis_family"]}, "then": {"properties": {"canonical_diff": {"items": {"oneOf": [{"$ref": "#/$defs/p01"}, {"$ref": "#/$defs/p02"}, {"$ref": "#/$defs/p04"}]}}}}},
    {"if": {"properties": {"hypothesis_family": {"const": "slow_drift_parameter"}}, "required": ["hypothesis_family"]}, "then": {"properties": {"canonical_diff": {"items": {"oneOf": [{"$ref": "#/$defs/p03"}, {"$ref": "#/$defs/p04"}]}}}}},
    {"if": {"properties": {"hypothesis_family": {"const": "context_feature"}}, "required": ["hypothesis_family"]}, "then": {"properties": {"canonical_diff": {"items": {"oneOf": [{"$ref": "#/$defs/f01"}, {"$ref": "#/$defs/f02"}]}}}}}
  ],
  "$defs": {
    "p01": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"const": "/P01/shrinkage"}, "value": {"type": "integer", "enum": [1, 5, 20, 100]}}},
    "p02": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"const": "/P02/training_window"}, "value": {"oneOf": [{"type": "integer", "enum": [50, 100, 150]}, {"const": "expanding"}]}}},
    "p03": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"const": "/P03/recency_half_life"}, "value": {"oneOf": [{"type": "integer", "enum": [26, 52, 104]}, {"const": "none"}]}}},
    "p04": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"const": "/P04/tick_group"}, "value": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": -4096, "maximum": 4096}}}},
    "f01": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"const": "/F01/enabled"}, "value": {"type": "boolean"}}},
    "f02": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"const": "/F02/config"}, "value": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "enum": ["weekday", "month", "holiday", "draw_gap", "recent_frequency", "recent_omission"]}}}},
    "patch": {"oneOf": [{"$ref": "#/$defs/p01"}, {"$ref": "#/$defs/p02"}, {"$ref": "#/$defs/p03"}, {"$ref": "#/$defs/p04"}, {"$ref": "#/$defs/f01"}, {"$ref": "#/$defs/f02"}]}
  }
}
