{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "status", "input_manifest_sha256", "availability_ledger_sha256", "historical_mode", "feature_fields", "label_fields", "label_unlock_state_machine", "external_feature_policy", "forbidden_fields", "rule_policy"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "artifact_type": {"const": "phase3_data_time_contract"},
    "status": {"const": "ready_for_results_blind_freeze"},
    "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "availability_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "historical_mode": {"const": "retrospective_sequence_safe"},
    "feature_fields": {"type": "array", "minItems": 1},
    "label_fields": {"const": ["front_numbers", "back_numbers"]},
    "label_unlock_state_machine": {"const": ["started", "forecast_locked", "label_unlocked", "scored", "terminal"]},
    "external_feature_policy": {"const": "require_genuine_available_at_before_prediction_lock_or_reject"},
    "forbidden_fields": {"type": "array", "minItems": 1, "uniqueItems": true},
    "rule_policy": {"type": "string", "minLength": 1}
  }
}
